<?xml version="1.0" encoding="UTF-8"?>
<!--
  ChurrOS Android — manifest base

  AOSP puro, sin GAPPS ni drivers privativos. El device tree concreto
  (kernel, blobs de vendor, bootloader) lo añade el manifest de gama
  correspondiente en manifests/devices/.

  Uso:
    repo init -u manifests/default.xml -b android15-release
-->
<manifest>
  <remote name="aosp"
          fetch="https://android.googlesource.com/platform/manifest"
          review="https://android.googlesource.com/platform/manifest"/>

  <!--
    Repositorio de device trees de ChurrOS. Los manifests de gama lo referencian
    por nombre; si prefieres usar los device trees de LineageOS directamente,
    cambia el fetch por https://github.com/LineageOS y los <project name=...>
    de manifests/devices/*.xml.
  -->
  <!--
    Código abierto que publica Motorola (kernel y módulos de conectividad de
    los SoCs MediaTek). Es lo único del fabricante que se puede distribuir
    legalmente: los blobs de /vendor (PowerVR, cámara, RIL) NO se publican.
  -->
  <remote name="motorola"
          fetch="https://github.com/MotorolaMobilityLLC"
          review="https://github.com/MotorolaMobilityLLC" />

  <!--
    Nadie publica código abierto de los teléfonos Xiaomi: sólo el kernel y los
    módulos de conectividad de la plataforma mt6789 (los publica el equipo
    xiaomi-mt6789-devs, que mantiene el Redmi Pad). Los blobs de /vendor
    (Mali, cámara, RIL) NO se publican y hay que extraerlos del firmware.
  -->
  <remote name="xiaomi-mt6789-devs"
          fetch="https://github.com/xiaomi-mt6789-devs"
          review="https://github.com/xiaomi-mt6789-devs" />

  <remote name="churros-devices"
          fetch="https://github.com/Hoyuse/churros-android-devices"
          review="https://github.com/Hoyuse/churros-android-devices"/>

  <!-- Herramientas de build fuera del repo de platform -->
  <project path="build/soong"
           name="build/soong"
           groups="aosp-build-extras" />
  <project path="build/blueprint"
           name="build/blueprint"
           groups="aosp-build-extras" />
  <project path="build/make"
           name="build/make"
           groups="aosp-build-extras" />
  <project path="external/treble"
           name="external/treble"
           groups="aosp-build-extras" />

  <!-- Runtime -->
  <project path="art"
           name="art"
           groups="aosp-runtime" />
  <project path="libartbase"
           name="libartbase"
           groups="aosp-runtime" />
  <project path="frameworks/native"
           name="frameworks/native"
           groups="aosp-runtime" />

  <!-- Framework -->
  <project path="frameworks/base"
           name="frameworks/base"
           groups="aosp-framework" />
  <project path="frameworks/opt/netd"
           name="frameworks/opt/netd"
           groups="aosp-framework" />
  <project path="frameworks/opt/telephony"
           name="frameworks/opt/telephony"
           groups="aosp-framework" />

  <!-- Núcleo del sistema -->
  <project path="system/core"
           name="system/core"
           groups="aosp-core" />
  <project path="system/init"
           name="system/init"
           groups="aosp-core" />
  <project path="system/sepolicy"
           name="system/sepolicy"
           groups="aosp-core" />
</manifest>